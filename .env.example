# Copy to .env (gitignored) and fill in. Nothing here is committed.
# Heavy spend is gated on the tier-probe — keys can stay blank until then.

# --- Unblocker API (hard-tier sites the browser pool still can't pass) ---
ZYTE_API_KEY=
SCRAPERAPI_KEY=

# --- LLM / vision structuring (OCR text + prose -> structured JSON) ---
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# --- Object storage (Cloudflare R2 / Backblaze B2, S3-compatible) ---
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=

# --- Always-on VM (informational; used by deploy scripts, not the code) ---
HARVEST_VM_HOST=
