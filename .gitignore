# Data & harvest outputs (multi-GB corpus lives in object storage, never in git)
/data/
!/data/.gitkeep

# Secrets
.env
*.key

# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Harvested binaries (should never be committed)
*.pdf
*.docx
*.xlsx
*.pptx

# CI download staging — working files, not source. 66 of these were committed by
# mistake in a `git add -A`; scratch/ by contrast holds 71 tracked analysis scripts.
/ci_out/

# Sweep outputs: derived, regenerable, and 191 MB of the tracked tree.
# The small CSVs under scratch/ stay -- CivicAtlasMA reads dive_confirmed.csv
# and recovered_missing_docs.csv across the repo boundary.
scratch/**/*.jsonl
_pout3/

# Workflow artifact downloads.  These arrive as untracked directories in the
# working tree and a `git add -A` sweeps them straight into a commit.
_rev_out/
_rev_out2/
_turley_out/
_turley_pdf/
url-batch-*/
cdx-shard-*/
